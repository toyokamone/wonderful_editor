<!DOCTYPE html>
<html>
  <head>
    <title>WonderfulEditor</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <div id="app"></div>
    <%= yield %>

    <!-- javascript_pack_tag を body の最後に配置 -->
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </body>
</html>
